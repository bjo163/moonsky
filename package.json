{
  "name": "moonsky",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm build:libs && pnpm --filter @moonsky/app build",
    "build:libs": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build:libs && pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "pnpm build:libs && pnpm --filter @moonsky/app dev",
    "start": "pnpm --filter @moonsky/app start",
    "db:generate": "pnpm --filter @moonsky/store db:generate",
    "db:migrate": "pnpm --filter @moonsky/store db:migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  }
}
