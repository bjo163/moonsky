{
  "name": "@moonsky/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "vite build && tsc -b",
    "build:client": "vite build",
    "dev": "node --import tsx --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -b && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "pnpm build:client && node --env-file-if-exists=../../.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@moonsky/core": "workspace:*",
    "@moonsky/store": "workspace:*",
    "@moonsky/telegram": "workspace:*",
    "@moonsky/whatsapp": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5"
  }
}
