# MOONSKY environment. Copy to .env for local runs; Docker Compose works without it.
# Defaults are loopback-bound and safe for a local machine only.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3005

# PostgreSQL connection string. Required outside development.
DATABASE_URL=postgresql://moonsky:moonsky@127.0.0.1:5433/moonsky

# Shared service credential for machine-initiated sends (32-256 characters).
MOONSKY_SERVICE_KEY=

# Telegram provider: configure both or neither. The webhook secret is at least 32 characters.
MOONSKY_TELEGRAM_BOT_TOKEN=
MOONSKY_TELEGRAM_WEBHOOK_SECRET=

# WhatsApp provider: set to a private session directory to enable the channel; empty disables it.
# Requires DATABASE_URL (D18 persistence is mandatory for a real provider). Keep the directory
# gitignored (whatsapp-session/ is ignored) and on a private volume — never a shared one.
MOONSKY_WHATSAPP_AUTH_DIR=

# First administrator, created only when no operator exists. The password is at least 12 characters.
MOONSKY_BOOTSTRAP_LOGIN=admin
MOONSKY_BOOTSTRAP_PASSWORD=
